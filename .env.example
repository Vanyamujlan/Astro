# Telegram Bot API token from @BotFather (required)
BOT_TOKEN=

# Firebase Project ID from Firebase Console (required)
FIREBASE_PROJECT_ID=

# Path to Firebase Admin SDK service account JSON file
# Leave empty only if running in GCP with Application Default Credentials (ADC)
FIREBASE_CREDENTIALS_PATH=

# Firestore Database ID (leave empty for "(default)" Native database)
FIREBASE_DATABASE_ID=

# Logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Runtime environment: development | staging | production
ENVIRONMENT=development
