# Telegram Bot API token from @BotFather (required)
BOT_TOKEN=your_telegram_bot_token

# Firebase Project ID (required)
FIREBASE_PROJECT_ID=your-firebase-project-id

# Firebase Service Account Client Email (required)
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com

# Firebase Service Account Private Key in single-line format with \n (required)
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Firestore Database ID (leave empty for "(default)" Native database)
FIREBASE_DATABASE_ID=

# Logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Runtime environment: development | staging | production
ENVIRONMENT=development
